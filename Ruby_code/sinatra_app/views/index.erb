<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Eltronesia Exploration Page</title>
    <style>
        body, html {
            height: 100%;
            margin: 0;
            overflow: hidden;
        }
        
        .background {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -1;
            background-color: #f0f0f0; /* fallback color */
            background-image: url('https://source.unsplash.com/random');
            background-size: cover;
            animation: slide 20s linear infinite alternate;
        }

        @keyframes slide {
            0% { transform: scale(1.2); }
            100% { transform: scale(1); }
        }

        .content {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            text-align: center;
            color: #333;
            font-family: Arial, sans-serif;
            z-index: 1;
        }

        h1 {
            font-size: 3rem;
        }

        p {
            font-size: 1.5rem;
            margin-top: 20px;
        }
    </style>
</head>
<body>
    <div class="background"></div>
    <div class="content">
        <h1>Welcome to the Eltronesia Web Exploration Page!</h1>
        <p>Let's embark on a magical journey together!</p>
    </div>
</body>
</html>
