<!-- app/views/sessions/new.html.erb -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      margin: 0;
      padding: 0;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
      overflow: hidden;
      position: relative;
      background-color: #1b75bb; /* Change the background color as needed */
    }
    .login-container {
      position: relative;
      background-color: rgba(255, 255, 255, 0.8); /* Semi-transparent white background */
      border-radius: 8px;
      box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
      padding: 40px;
      width: 300px;
      animation: fadeInUp 0.5s ease;
    }
    .login-container h2 {
      margin-bottom: 20px;
      text-align: center;
    }
    .form-group {
      margin-bottom: 20px;
    }
    .form-group label {
      display: block;
      font-weight: bold;
    }
    .form-group input[type="text"],
    .form-group input[type="password"] {
      width: 100%;
      padding: 10px;
      border: 1px solid #ccc;
      border-radius: 5px;
      box-sizing: border-box;
      transition: border-color 0.3s;
    }
    .form-group input[type="text"]:focus,
    .form-group input[type="password"]:focus {
      border-color: #007bff;
    }
    .form-group button {
      width: 100%;
      padding: 10px;
      background-color: #007bff;
      color: #fff;
      border: none;
      border-radius: 5px;
      cursor: pointer;
      transition: background-color 0.3s;
    }
    .form-group button:hover {
      background-color: #0056b3;
    }
    .form-group .error-message {
      color: red;
      font-size: 0.8em;
    }

    /* Fade in animation */
    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* Fish Animation */
    .fish {
      position: absolute;
      width: 50px;
      height: 30px;
      background-color: #ffa500; /* Fish color */
      border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
      animation: fishSwim 5s linear infinite alternate;
      z-index: -1;
    }

    @keyframes fishSwim {
      0% {
        left: -50px;
        transform: scaleX(1);
      }
      50% {
        left: calc(100% + 50px);
        transform: scaleX(-1);
      }
      100% {
        left: -50px;
        transform: scaleX(1);
      }
    }
  </style>
</head>
<body>

<!-- Fish Animation Layer -->
<div class="fish"></div>

<div class="login-container">
  <h2>Login</h2>
  <%= form_with url: sessions_path do |form| %>
    <% if flash[:alert] %>
      <div class="form-group">
        <p class="error-message"><%= flash[:alert] %></p>
      </div>
    <% end %>
    <div class="form-group">
      <%= form.label :email %>
      <%= form.text_field :email, id: "email", required: true %>
    </div>
    <div class="form-group">
      <%= form.label :password %>
      <%= form.password_field :password, id: "password", required: true %>
    </div>
    <div class="form-group">
      <%= form.submit "Login" %>
    </div>
  <% end %>
</div>

</body>
</html>
